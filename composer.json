{
  "name": "rippera/laravel-api-types",
  "description": "Generate TypeScript types, enums and interfaces from Laravel routes, FormRequests and PHP enums",
  "keywords": [
    "laravel",
    "typescript",
    "codegen",
    "api",
    "types",
    "form-request",
    "api-resources"
  ],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Mikheil Mezurnishvili",
      "email": "mikheil.mez@gmail.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "laravel/framework": "^10.0|^11.0|^12.0|^13.0",
    "nikic/php-parser": "^5.0"
  },
  "autoload": {
    "psr-4": {
      "ApiTypes\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "ApiTypes\\ApiTypesServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  }
}
